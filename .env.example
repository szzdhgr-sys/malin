NODE_ENV=production
PORT=3000
DB_PATH=data/shop.db
JWT_SECRET=<généré automatiquement par Railway si vous utilisez "Generate">
ADMIN_EMAIL=<votre email pour vous connecter à l'administration>
ADMIN_PASSWORD=<un mot de passe d'au moins 12 caractères>
# Aucune variable Telegram : l'application est indépendante du robot.
# Optionnel, plus tard : fournisseur IA / vision (clés côté serveur uniquement).
